# PostgreSQL (Docker)
POSTGRES_DB=signy
POSTGRES_USER=signy
POSTGRES_PASSWORD=changer_ce_mot_de_passe

# pgAdmin (Docker)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=changer_ce_mot_de_passe

# Connexion locale facultative : sans DATABASE_URL, SQLite est utilisé.
# DATABASE_URL=postgresql+psycopg2://utilisateur:mot_de_passe@localhost:5432/signy
